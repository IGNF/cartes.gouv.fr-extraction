BASE_URL="/extraction"

# Client OIDC public avec PKCE, sans secret.
# 1 désactive uniquement silentRestore au démarrage.
IAM_DISABLE="0"
# Vide : issuer dérivé de IAM_URL et IAM_REALM par createAuthOptions().
IAM_AUTHORITY=""
IAM_URL="https://sso.geopf.fr"
IAM_REALM="geoplateforme"
IAM_CLIENT_ID="cartes-gouv-public"
# URI vides : origine + base normalisée + login / silent-renew.html ; logout à la base.
IAM_REDIRECT_URI=""
IAM_POST_LOGOUT_REDIRECT_URI=""
IAM_SILENT_REDIRECT_URI=""
IAM_SCOPE="openid profile email"
IAM_STORAGE="memory"
IAM_DEBUG="false"

# Seules les deux bases d'API peuvent recevoir le Bearer token.
IAM_ENTREPOT_API_URL="https://data.geopf.fr/api"
# IAM_API_EXTRACTION_URL est héritée du fichier .env commun en mode Vite.
# Déploiement : fournir explicitement l'API d'extraction de l'environnement cible.
# Fichier des alertes cartes.gouv.fr (cf. src/types/alert.types.ts)
ALERTS_URL="https://gpf-annex-qua.priv.geopf.fr/annexes/cartes.gouv.fr-config/public/alerts.json"
